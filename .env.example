# Ushbu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# Vercel/Netlify'da esa Settings -> Environment Variables bo'limiga kiriting.

# Saytning asosiy manzili (canonical, sitemap, Open Graph uchun)
NEXT_PUBLIC_SITE_URL=https://promach.uz

# Telegram bot (forma so'rovlari shu botga keladi). Bo'sh bo'lsa forma DEMO rejimida ishlaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analitika (bo'sh qoldirilsa skript yuklanmaydi)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# Qidiruv tizimlari tasdiqlash kodlari (faqat content="..." ichidagi qiymat)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
