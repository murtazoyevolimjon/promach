# Ushbu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# Vercel'da esa Settings -> Environment Variables bo'limiga kiriting.
# DIQQAT: .env.local GitHub'ga chiqmaydi (.gitignore). Bu faylga (.env.example) haqiqiy kalit YOZMANG.

# Saytning asosiy manzili (canonical, sitemap, Open Graph uchun)
NEXT_PUBLIC_SITE_URL=https://promach.uz

# --- Telegram bot (forma so'rovlari shu botga keladi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase (ixtiyoriy: so'rovlarni "leads" jadvaliga ham yozish) ---
# Supabase -> Project Settings -> API Keys. SECRET kalitni oling ("sb_secret_..." yoki eski "service_role").
# Hech qachon NEXT_PUBLIC_ prefiksi bilan yozmang — bu kalit faqat serverda qolishi shart!
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram ham, Supabase ham bo'sh bo'lsa forma DEMO rejimda ishlaydi.

# --- Analitika (bo'sh qoldirilsa skript yuklanmaydi) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# --- Qidiruv tizimlari tasdiqlash kodlari (faqat content="..." ichidagi qiymat) ---
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
